{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@zipy/db": ["packages/db/src/index.ts"],
      "@zipy/db/*": ["packages/db/src/*"],
      "@zipy/storage": ["packages/storage/src/index.ts"],
      "@zipy/storage/*": ["packages/storage/src/*"],
      "@zipy/jobs": ["packages/jobs/src/index.ts"],
      "@zipy/jobs/*": ["packages/jobs/src/*"],
      "@zipy/hashing": ["packages/hashing/src/index.ts"],
      "@zipy/hashing/*": ["packages/hashing/src/*"],
      "@zipy/ingest": ["packages/ingest/src/index.ts"],
      "@zipy/ingest/*": ["packages/ingest/src/*"],
      "@zipy/processing": ["packages/processing/src/index.ts"],
      "@zipy/processing/*": ["packages/processing/src/*"],
      "@zipy/fusion": ["packages/fusion/src/index.ts"],
      "@zipy/fusion/*": ["packages/fusion/src/*"],
      "@zipy/synth": ["packages/synth/src/index.ts"],
      "@zipy/synth/*": ["packages/synth/src/*"],
      "@zipy/automation": ["packages/automation/src/index.ts"],
      "@zipy/automation/*": ["packages/automation/src/*"],
      "@zipy/images": ["packages/images/src/index.ts"],
      "@zipy/images/*": ["packages/images/src/*"],
      "@zipy/annotate": ["packages/annotate/src/index.ts"],
      "@zipy/annotate/*": ["packages/annotate/src/*"],
      "@zipy/content": ["packages/content/src/index.ts"],
      "@zipy/content/*": ["packages/content/src/*"],
      "@zipy/llm": ["packages/llm/src/index.ts"],
      "@zipy/llm/*": ["packages/llm/src/*"],
      "@zipy/i18n": ["packages/i18n/src/index.ts"],
      "@zipy/i18n/*": ["packages/i18n/src/*"],
      "@zipy/seo": ["packages/seo/src/index.ts"],
      "@zipy/seo/*": ["packages/seo/src/*"],
      "@zipy/quality": ["packages/quality/src/index.ts"],
      "@zipy/quality/*": ["packages/quality/src/*"],
      "@zipy/safety": ["packages/safety/src/index.ts"],
      "@zipy/safety/*": ["packages/safety/src/*"],
      "@zipy/templates": ["packages/templates/src/index.ts"],
      "@zipy/templates/*": ["packages/templates/src/*"],
      "@zipy/collab": ["packages/collab/src/index.ts"],
      "@zipy/collab/*": ["packages/collab/src/*"],
      "@zipy/review": ["packages/review/src/index.ts"],
      "@zipy/review/*": ["packages/review/src/*"],
      "@zipy/export": ["packages/export/src/index.ts"],
      "@zipy/export/*": ["packages/export/src/*"],
      "@zipy/publishing": ["packages/publishing/src/index.ts"],
      "@zipy/publishing/*": ["packages/publishing/src/*"],
      "@zipy/integrations": ["packages/integrations/src/index.ts"],
      "@zipy/integrations/*": ["packages/integrations/src/*"],
      "@zipy/webhooks": ["packages/webhooks/src/index.ts"],
      "@zipy/webhooks/*": ["packages/webhooks/src/*"],
      "@zipy/security": ["packages/security/src/index.ts"],
      "@zipy/security/*": ["packages/security/src/*"],
      "@zipy/analytics": ["packages/analytics/src/index.ts"],
      "@zipy/analytics/*": ["packages/analytics/src/*"],
      "@zipy/platform": ["packages/platform/src/index.ts"],
      "@zipy/platform/*": ["packages/platform/src/*"],
      "@zipy/lifecycle": ["packages/lifecycle/src/index.ts"],
      "@zipy/lifecycle/*": ["packages/lifecycle/src/*"],
      "@zipy/billing": ["packages/billing/src/index.ts"],
      "@zipy/billing/*": ["packages/billing/src/*"],
      "@zipy/branding": ["packages/branding/src/index.ts"],
      "@zipy/branding/*": ["packages/branding/src/*"],
      "@zipy/sdk-js": ["packages/sdk-js/src/index.ts"],
      "@zipy/sdk-js/*": ["packages/sdk-js/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "packages/sdk-python/**"
  ]
}

# Zipy AI — on-premise environment template.
#
# Copy this file to /etc/zipy/zipy.env, fill in the customer-supplied values,
# and point the systemd units at it (`EnvironmentFile=/etc/zipy/zipy.env`).
# Never commit a filled copy: this file is tracked and must contain only
# placeholders. Every value shown here is an example, not a default.
#
# Sections marked "REQUIRED" cause the process to refuse to start when
# missing. Sections marked "OPTIONAL" cause the dependent feature to return
# an explicit 503 naming the missing variable rather than degrading silently.

# ---------------------------------------------------------------------------
# REQUIRED — process cannot start without these
# ---------------------------------------------------------------------------

# Postgres 16 with the pgvector, pg_trgm and pgcrypto extensions available.
# Use a least-privilege role; the migrate step needs CREATE EXTENSION
# privileges once, after which the role can be narrowed.
DATABASE_URL=postgres://zipy:REPLACE_ME@127.0.0.1:5432/zipy

# At least 32 random characters. Generate with `openssl rand -hex 32`.
# Identical across every web replica; it is the session HMAC key.
SESSION_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Absolute https URL an end user can reach. Used for links, Open Graph tags,
# signed webhook URLs and the public guide pages.
PUBLIC_BASE_URL=https://zipy.example.com

# Comma-separated; "*" is refused in production. Include the public origin
# and any internal tool that calls the REST API.
CORS_ALLOWED_ORIGINS=https://zipy.example.com

# ---------------------------------------------------------------------------
# REQUIRED when STORAGE_DRIVER=s3 — object storage for artifacts and screenshots
# ---------------------------------------------------------------------------

STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_ROOT=/var/lib/zipy/objects
# Set the four S3_* values below when STORAGE_DRIVER=s3.
S3_ENDPOINT=https://s3.example.com           # omit for AWS S3
S3_REGION=us-east-1
S3_BUCKET=zipy-artifacts
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=true                      # required for MinIO/Wasabi

# ---------------------------------------------------------------------------
# REQUIRED — at least one LLM provider (see docs/operations/external-setup.md)
# ---------------------------------------------------------------------------

# The default provider is used when a request does not specify one. Local
# open-source models via Ollama or vLLM are the on-premise default; a hosted
# provider can be added for fallback or for higher-quality synthesis.
LLM_DEFAULT_PROVIDER=ollama     # openai | anthropic | gemini | ollama | vllm
LLM_FALLBACK_CHAIN=             # comma-separated, e.g. openai,anthropic

# Local providers (no API key, only a base URL).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
VLLM_BASE_URL=                  # e.g. http://127.0.0.1:8000/v1
VLLM_MODEL=

# Hosted providers (customer-supplied keys; leave blank to disable).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# OPTIONAL — local processing services (OCR, layout, speech-to-text)
# ---------------------------------------------------------------------------

# OCR_ENGINE=auto (default) uses EasyOCR when importable, else Tesseract.
# Set to `cloud` only when the operator adds a cloud driver.
OCR_ENGINE=auto                  # easyocr | tesseract | cloud | auto
PYTHON_PATH=python3
OCR_SERVICE_URL=                 # set when OCR runs as a sidecar service

LAYOUT_ENGINE=docling            # docling | none
DOCLING_SERVICE_URL=http://127.0.0.1:8002

STT_ENGINE=none                  # whisper-local | whisper-cpp | cloud | none
STT_SERVICE_URL=http://127.0.0.1:8003

# ---------------------------------------------------------------------------
# OPTIONAL — browser automation
# ---------------------------------------------------------------------------

PLAYWRIGHT_BROWSER=chromium      # chromium | firefox | webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_DEVICE_SCALE=2
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=15000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=45000
PLAYWRIGHT_MAX_CONTEXTS=2
PLAYWRIGHT_PROXY_URL=            # e.g. http://proxy.example.com:8080

# ---------------------------------------------------------------------------
# OPTIONAL — queue scaling
# ---------------------------------------------------------------------------

# Absent = the in-process/Postgres-backed queue only. Set to a shared Redis
# when running several worker replicas behind a load balancer.
REDIS_URL=
JOBS_CONCURRENCY=4
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_BASE_MS=5000
JOBS_POLL_INTERVAL_MS=1000
JOBS_LOCK_TTL_MS=300000

# ---------------------------------------------------------------------------
# OPTIONAL — outbound webhooks
# ---------------------------------------------------------------------------

# Outgoing deliveries are refused unsigned when this is missing. Set a
# long random string and store it in the receiver's verification config.
WEBHOOK_SIGNING_SECRET=REPLACE_ME
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# REQUIRED before accepting customer data — encryption at rest
# ---------------------------------------------------------------------------

# Per-workspace envelope key derivation. Rotation is a manual operation;
# see §7 of docs/operations/on-prem.md.
ENCRYPTION_MASTER_KEY=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# ---------------------------------------------------------------------------
# OPTIONAL — email delivery (invites, review notifications)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=zipy@example.com

# ---------------------------------------------------------------------------
# OPTIONAL — enterprise identity (see file13.sh for the SAML block)
# ---------------------------------------------------------------------------

# SAML_ENTRY_POINT=https://idp.example.com/saml/sso
# SAML_ISSUER=https://idp.example.com
# SAML_IDP_METADATA_URL=https://idp.example.com/saml/metadata
# SAML_IDP_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ---------------------------------------------------------------------------
# OPTIONAL — billing (model + metering only; live charges require Stripe)
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — compliance policy defaults (per-workspace overrides via /admin)
# ---------------------------------------------------------------------------

DEFAULT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# OPTIONAL — operational
# ---------------------------------------------------------------------------

# Replit uses PORT; when unset the app falls back to 3000 for local dev only.
# Bind is always 0.0.0.0.
PORT=3000
NODE_ENV=production
SESSION_COOKIE_NAME=zipy_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=2592000
ALLOW_SIGNUP=true
LOG_LEVEL=info
